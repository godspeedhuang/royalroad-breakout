# MIT Parley connection settings. Once filled in, do not commit this file or share it.
# The code reads this file with python-dotenv.

# Parley API key
PARLEY_API_KEY=

# Parley API base URL (for an OpenAI-compatible endpoint it usually looks like https://.../v1; follow Parley's docs)
PARLEY_BASE_URL=

# embedding model
EMBEDDING_MODEL=text-embedding-3-small
