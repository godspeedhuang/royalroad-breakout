.venv/
.env
__pycache__/
.ipynb_checkpoints/
.DS_Store

# Large files stay out of git (raw data, intermediate files, vectors) and are shared through the cloud; see "Large files" in the README
# Folders are kept with .gitkeep so the structure exists after cloning
/data/**
!/data/raw/
!/data/interim/
!/data/**/.gitkeep
embedding/out/emb_parts/*
!embedding/out/emb_parts/.gitkeep
*.parquet

# Exception: the Atlas on GitHub Pages reads these two files (public version, no author names, 300-character excerpts)
!docs/atlas/*/data/dataset.parquet

# Personal editor settings
.vscode/
.claude/

# Office lock files created while a document is open
~$*

# Cover thumbnail sheets (cover art belongs to the authors; not public)
cover/out/clusters/cluster_*.png
